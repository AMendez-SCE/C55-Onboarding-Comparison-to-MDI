import pandas as pd
import numpy as np
import re
from difflib import SequenceMatcher

# ==================================================
# CONFIGURATION
# ==================================================

INPUT_FILE = "MDI TPP List Analysis.xlsx"

MDI_SHEET = "All TPP"
C55_SHEET = "Matching C55 Projects"

MDI_KEY = "Shared Cost Number"
C55_KEY = "MDI Legacy Shared Cost #"

AUTO_ACCEPT_THRESHOLD = 0.90
AMBIGUOUS_THRESHOLD = 0.75

# ==================================================
# MANUAL COLUMN OVERRIDES
# ==================================================

MANUAL_COLUMN_MAP = {
    "Shared Cost Number": "MDI Legacy Shared Cost #",
    # Examples:
    # "PM Name": "Project Manager",
    # "BPO": "Business Project Owner",
    # "Forecast Finish": "Forecast End Date"
}

# ==================================================
# HELPERS
# ==================================================

def normalize_column_name(value):

    if pd.isna(value):
        return ""

    value = str(value).strip().lower()

    value = value.replace("&", "and")
    value = value.replace("#", "number")

    value = re.sub(r"[^a-z0-9]", "", value)

    return value


def normalize_value(value):

    if pd.isna(value):
        return ""

    if isinstance(value, pd.Timestamp):
        return value.strftime("%Y-%m-%d")

    if isinstance(value, float):

        # Normalize 1 and 1.0
        if value.is_integer():
            return str(int(value))

        return str(round(value, 6))

    return str(value).strip()


def fuzzy_score(a, b):

    return SequenceMatcher(
        None,
        normalize_column_name(a),
        normalize_column_name(b)
    ).ratio()


# ==================================================
# LOAD DATA
# ==================================================

mdi = pd.read_excel(
    INPUT_FILE,
    sheet_name=MDI_SHEET,
    engine="openpyxl"
)

c55 = pd.read_excel(
    INPUT_FILE,
    sheet_name=C55_SHEET,
    engine="openpyxl"
)

mdi.columns = [str(c).strip() for c in mdi.columns]
c55.columns = [str(c).strip() for c in c55.columns]

# ==================================================
# DUPLICATE KEY CHECKS
# ==================================================

mdi_duplicates = (
    mdi[mdi[MDI_KEY].duplicated(keep=False)]
    .sort_values(MDI_KEY)
)

c55_duplicates = (
    c55[c55[C55_KEY].duplicated(keep=False)]
    .sort_values(C55_KEY)
)

# ==================================================
# BUILD COLUMN MAP
# ==================================================

mapping_rows = []

mapped_pairs = {}

for mdi_col in mdi.columns:

    # ------------------------------------------
    # MANUAL OVERRIDE
    # ------------------------------------------

    if mdi_col in MANUAL_COLUMN_MAP:

        c55_col = MANUAL_COLUMN_MAP[mdi_col]

        mapping_rows.append({
            "MDI Column": mdi_col,
            "C55 Column": c55_col,
            "Match Type": "Manual",
            "Best Score": 1.000,
            "Second Best": None,
            "Second Score": None,
            "Status": "Accepted"
        })

        mapped_pairs[mdi_col] = c55_col

        continue

    # ------------------------------------------
    # EXACT NORMALIZED MATCH
    # ------------------------------------------

    exact_match = None

    for candidate in c55.columns:

        if (
            normalize_column_name(mdi_col)
            ==
            normalize_column_name(candidate)
        ):
            exact_match = candidate
            break

    if exact_match:

        mapping_rows.append({
            "MDI Column": mdi_col,
            "C55 Column": exact_match,
            "Match Type": "Exact",
            "Best Score": 1.000,
            "Second Best": None,
            "Second Score": None,
            "Status": "Accepted"
        })

        mapped_pairs[mdi_col] = exact_match

        continue

    # ------------------------------------------
    # FUZZY MATCH
    # ------------------------------------------

    candidates = []

    for c55_col in c55.columns:

        score = fuzzy_score(
            mdi_col,
            c55_col
        )

        candidates.append(
            (c55_col, score)
        )

    candidates.sort(
        key=lambda x: x[1],
        reverse=True
    )

    best_col, best_score = candidates[0]

    if len(candidates) > 1:
        second_col, second_score = candidates[1]
    else:
        second_col = None
        second_score = None

    status = "Rejected"

    if best_score >= AUTO_ACCEPT_THRESHOLD:
        status = "Accepted"

    elif best_score >= AMBIGUOUS_THRESHOLD:
        status = "Ambiguous"

    # ------------------------------------------
    # CLOSE SCORES = REVIEW REQUIRED
    # ------------------------------------------

    if (
        second_score is not None
        and best_score >= AMBIGUOUS_THRESHOLD
        and abs(best_score - second_score) < 0.05
    ):
        status = "Ambiguous"

    mapping_rows.append({
        "MDI Column": mdi_col,
        "C55 Column": best_col,
        "Match Type": "Fuzzy",
        "Best Score": round(best_score, 3),
        "Second Best": second_col,
        "Second Score": (
            round(second_score, 3)
            if second_score
            else None
        ),
        "Status": status
    })

    if status == "Accepted":
        mapped_pairs[mdi_col] = best_col

mapping_df = pd.DataFrame(mapping_rows)

# ==================================================
# PREPARE KEYS
# ==================================================

mdi["_KEY"] = (
    mdi[MDI_KEY]
    .astype(str)
    .str.strip()
)

c55["_KEY"] = (
    c55[C55_KEY]
    .astype(str)
    .str.strip()
)

mdi_index = mdi.set_index(
    "_KEY",
    drop=False
)

c55_index = c55.set_index(
    "_KEY",
    drop=False
)

mdi_keys = set(mdi_index.index)
c55_keys = set(c55_index.index)

matching_keys = sorted(
    mdi_keys & c55_keys
)

mdi_only = sorted(
    mdi_keys - c55_keys
)

c55_only = sorted(
    c55_keys - mdi_keys
)

# ==================================================
# FIELD COMPARISON
# ==================================================

difference_rows = []

for key in matching_keys:

    mdi_row = mdi_index.loc[key]
    c55_row = c55_index.loc[key]

    if isinstance(mdi_row, pd.DataFrame):
        mdi_row = mdi_row.iloc[0]

    if isinstance(c55_row, pd.DataFrame):
        c55_row = c55_row.iloc[0]

    for mdi_col, c55_col in mapped_pairs.items():

        mdi_value = mdi_row.get(mdi_col)
        c55_value = c55_row.get(c55_col)

        mdi_value_norm = normalize_value(mdi_value)
        c55_value_norm = normalize_value(c55_value)

        if mdi_value_norm != c55_value_norm:

            difference_rows.append({
                "Shared Cost Number": key,
                "MDI Column": mdi_col,
                "C55 Column": c55_col,
                "MDI Value": mdi_value,
                "C55 Value": c55_value,
                "Difference Type": "Value Changed"
            })

differences_df = pd.DataFrame(
    difference_rows
)

# ==================================================
# REVIEW REQUIRED
# ==================================================

review_df = mapping_df[
    mapping_df["Status"] == "Ambiguous"
].copy()

rejected_df = mapping_df[
    mapping_df["Status"] == "Rejected"
].copy()

# ==================================================
# SUMMARY
# ==================================================

summary_df = pd.DataFrame({
    "Metric": [
        "MDI Records",
        "C55 Records",
        "Matching Shared Cost Numbers",
        "MDI Only",
        "C55 Only",
        "Accepted Column Maps",
        "Ambiguous Column Maps",
        "Rejected Column Maps",
        "Field Differences"
    ],
    "Value": [
        len(mdi),
        len(c55),
        len(matching_keys),
        len(mdi_only),
        len(c55_only),
        len(mapping_df[mapping_df["Status"]=="Accepted"]),
        len(review_df),
        len(rejected_df),
        len(differences_df)
    ]
})

# ==================================================
# OUTPUT
# ==================================================

OUTPUT_FILE = "MDI_TPP_Reconciliation.xlsx"

with pd.ExcelWriter(
    OUTPUT_FILE,
    engine="openpyxl"
) as writer:

    summary_df.to_excel(
        writer,
        sheet_name="Summary",
        index=False
    )

    mapping_df.to_excel(
        writer,
        sheet_name="Column Mapping Matrix",
        index=False
    )

    review_df.to_excel(
        writer,
        sheet_name="Review Required",
        index=False
    )

    rejected_df.to_excel(
        writer,
        sheet_name="Rejected Matches",
        index=False
    )

    differences_df.to_excel(
        writer,
        sheet_name="Field Differences",
        index=False
    )

    pd.DataFrame({
        "Shared Cost Number": mdi_only
    }).to_excel(
        writer,
        sheet_name="MDI Only",
        index=False
    )

    pd.DataFrame({
        "Shared Cost Number": c55_only
    }).to_excel(
        writer,
        sheet_name="C55 Only",
        index=False
    )

    mdi_duplicates.to_excel(
        writer,
        sheet_name="MDI Duplicates",
        index=False
    )

    c55_duplicates.to_excel(
        writer,
        sheet_name="C55 Duplicates",
        index=False
    )

print(f"Created {OUTPUT_FILE}")
