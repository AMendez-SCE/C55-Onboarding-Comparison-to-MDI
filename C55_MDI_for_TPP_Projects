import pandas as pd
import re
from difflib import SequenceMatcher

from openpyxl import load_workbook
from openpyxl.styles import (
    Font,
    PatternFill,
    Border,
    Side,
    Alignment
)
from openpyxl.formatting.rule import CellIsRule
from openpyxl.worksheet.table import (
    Table,
    TableStyleInfo
)
from openpyxl.utils import get_column_letter

# ============================================================
# CONFIGURATION
# ============================================================

INPUT_FILE = "MDI TPP List Analysis.xlsx"

from pathlib import Path
desktop = Path.home() / "Desktop"
OUTPUT_FILE = desktop / "MDI_TPP_Reconciliation.xlsx"

MDI_SHEET = "All TPP"
C55_SHEET = "Matching C55 Projects"

MDI_KEY = "Shared Cost Number"
C55_KEY = "MDI Legacy Shared Cost #"

AUTO_ACCEPT_THRESHOLD = 0.90
AMBIGUOUS_THRESHOLD = 0.75

# ============================================================
# OPTIONAL MANUAL MAPPINGS
# ============================================================

MANUAL_COLUMN_MAP = {
    "Shared Cost Number": "MDI Legacy Shared Cost #",
    # "PM Name": "Project Manager",
    # "BPO": "Business Project Owner",
    # "Forecast Finish": "Forecast End Date",
}

# ============================================================
# EXCEL STYLES
# ============================================================

HEADER_FILL = PatternFill(
    "solid",
    fgColor="1F4E78"
)

HEADER_FONT = Font(
    color="FFFFFF",
    bold=True
)

GREEN_FILL = PatternFill(
    "solid",
    fgColor="C6EFCE"
)

YELLOW_FILL = PatternFill(
    "solid",
    fgColor="FFF2CC"
)

RED_FILL = PatternFill(
    "solid",
    fgColor="FFC7CE"
)

GRAY_FILL = PatternFill(
    "solid",
    fgColor="D9D9D9"
)

BORDER = Border(
    bottom=Side(
        style="thin",
        color="808080"
    )
)

# ============================================================
# HELPERS
# ============================================================

def normalize_column_name(value):

    if pd.isna(value):
        return ""

    value = str(value).strip().lower()

    value = value.replace("&", "and")
    value = value.replace("#", "number")

    value = re.sub(
        r"[^a-z0-9]",
        "",
        value
    )

    return value


def normalize_value(value):

    if pd.isna(value):
        return ""

    if isinstance(value, pd.Timestamp):
        return value.strftime("%Y-%m-%d")

    if isinstance(value, float):

        if value.is_integer():
            return str(int(value))

        return str(round(value, 6))

    return str(value).strip()


def fuzzy_score(a, b):

    return SequenceMatcher(
        None,
        normalize_column_name(a),
        normalize_column_name(b)
    ).ratio()


# ============================================================
# EXCEL FORMAT HELPERS
# ============================================================

def style_headers(ws):

    for cell in ws[1\]:

        cell.fill = HEADER_FILL
        cell.font = HEADER_FONT
        cell.border = BORDER
        cell.alignment = Alignment(
            horizontal="center"
        )


def auto_fit_columns(ws):

    for column in ws.columns:

        width = 0

        letter = get_column_letter(
            column[0].column
        )

        for cell in column:

            try:

                if cell.value is not None:

                    width = max(
                        width,
                        len(str(cell.value))
                    )

            except:
                pass

        ws.column_dimensions[
            letter
        ].width = min(width + 3, 60)


def add_table(ws):

    if ws.max_row < 2:
        return

    ref = (
        f"A1:"
        f"{get_column_letter(ws.max_column)}"
        f"{ws.max_row}"
    )

    table_name = (
        ws.title
        .replace(" ", "_")
        .replace("-", "_")
    )

    table_name = re.sub(
        r"[^A-Za-z0-9_]",
        "",
        table_name
    )

    table = Table(
        displayName=table_name[:250],
        ref=ref
    )

    table.tableStyleInfo = TableStyleInfo(
        name="TableStyleMedium2",
        showRowStripes=True,
        showColumnStripes=False
    )

    ws.add_table(table)


def format_sheet(ws):

    style_headers(ws)

    ws.freeze_panes = "A2"

    add_table(ws)

    auto_fit_columns(ws)


# ============================================================
# LOAD DATA
# ============================================================

mdi = pd.read_excel(
    INPUT_FILE,
    sheet_name=MDI_SHEET,
    engine="openpyxl"
)

c55 = pd.read_excel(
    INPUT_FILE,
    sheet_name=C55_SHEET,
    engine="openpyxl"
)

mdi.columns = [str(c).strip() for c in mdi.columns]
c55.columns = [str(c).strip() for c in c55.columns]

# ============================================================
# DUPLICATES
# ============================================================

mdi_duplicates = mdi[
    mdi[MDI_KEY].duplicated(
        keep=False
    )
].sort_values(MDI_KEY)

c55_duplicates = c55[
    c55[C55_KEY].duplicated(
        keep=False
    )
].sort_values(C55_KEY)

# ============================================================
# COLUMN MAPPING
# ============================================================

mapping_rows = []
mapped_pairs = {}

for mdi_col in mdi.columns:

    # --------------------------------
    # Manual mapping
    # --------------------------------

    if mdi_col in MANUAL_COLUMN_MAP:

        c55_col = MANUAL_COLUMN_MAP[mdi_col]

        mapping_rows.append({
            "MDI Column": mdi_col,
            "C55 Column": c55_col,
            "Match Type": "Manual",
            "Best Score": 1.0,
            "Second Best": "",
            "Second Score": "",
            "Status": "Accepted"
        })

        mapped_pairs[mdi_col] = c55_col

        continue

    # --------------------------------
    # Exact normalized match
    # --------------------------------

    found_exact = None

    for c55_col in c55.columns:

        if (
            normalize_column_name(mdi_col)
            ==
            normalize_column_name(c55_col)
        ):

            found_exact = c55_col
            break

    if found_exact:

        mapping_rows.append({
            "MDI Column": mdi_col,
            "C55 Column": found_exact,
            "Match Type": "Exact",
            "Best Score": 1.0,
            "Second Best": "",
            "Second Score": "",
            "Status": "Accepted"
        })

        mapped_pairs[mdi_col] = found_exact

        continue

    # --------------------------------
    # Fuzzy match
    # --------------------------------

    scores = []

    for c55_col in c55.columns:

        score = fuzzy_score(
            mdi_col,
            c55_col
        )

        scores.append(
            (c55_col, score)
        )

    scores.sort(
        key=lambda x: x[1],
        reverse=True
    )

    best_col, best_score = scores[0]

    second_col = ""
    second_score = ""

    if len(scores) > 1:

        second_col, second_score = scores[1]

    status = "Rejected"

    if best_score >= AUTO_ACCEPT_THRESHOLD:

        status = "Accepted"

    elif best_score >= AMBIGUOUS_THRESHOLD:

        status = "Ambiguous"

    if (
score != ""
        and abs(best_score - second_score) < 0.05
        and best_score >= AMBIGUOUS_THRESHOLD
    ):
        status = "Ambiguous"

    mapping_rows.append({
        "MDI Column": mdi_col,
        "C55 Column": best_col,
        "Match Type": "Fuzzy",
        "Best Score": round(best_score, 3),
        "Second Best": second_col,
        "Second Score": (
            round(second_score, 3)
            if second_score != ""
            else ""
        ),
        "Status": status
    })

    if status == "Accepted":

        mapped_pairs[mdi_col] = best_col

mapping_df = pd.DataFrame(
    mapping_rows
)

# ============================================================
# PREPARE KEYS
# ============================================================

mdi["_KEY"] = (
    mdi[MDI_KEY]
    .astype(str)
    .str.strip()
)

c55["_KEY"] = (
    c55[C55_KEY]
    .astype(str)
    .str.strip()
)

mdi_index = mdi.set_index(
    "_KEY",
    drop=False
)

c55_index = c55.set_index(
    "_KEY",
    drop=False
)

mdi_keys = set(mdi_index.index)
c55_keys = set(c55_index.index)

matching_keys = sorted(
    mdi_keys & c55_keys
)

mdi_only = sorted(
    mdi_keys - c55_keys
)

c55_only = sorted(
    c55_keys - mdi_keys
)

# ============================================================
# FIELD COMPARISON
# ============================================================

differences = []

for key in matching_keys:

    mdi_row = mdi_index.loc[key]
    c55_row = c55_index.loc[key]

    if isinstance(
        mdi_row,
        pd.DataFrame
    ):
        mdi_row = mdi_row.iloc[0]

    if isinstance(
        c55_row,
        pd.DataFrame
    ):
        c55_row = c55_row.iloc[0]

    for mdi_col, c55_col in mapped_pairs.items():

        mdi_value = mdi_row.get(
            mdi_col
        )

        c55_value = c55_row.get(
            c55_col
        )

        if (
            normalize_value(mdi_value)
            !=
            normalize_value(c55_value)
        ):

            differences.append({
                "Shared Cost Number": key,
                "MDI Column": mdi_col,
                "C55 Column": c55_col,
                "MDI Value": mdi_value,
                "C55 Value": c55_value,
                "Difference Type": "Value Changed"
            })

differences_df = pd.DataFrame(
    differences
)

review_df = mapping_df[
    mapping_df["Status"] == "Ambiguous"
]

rejected_df = mapping_df[
    mapping_df["Status"] == "Rejected"
]

# ============================================================
# SUMMARY
# ============================================================

summary_df = pd.DataFrame({

    "Metric": [

        "MDI Records",
        "C55 Records",
        "Matching Shared Cost Numbers",
        "MDI Only",
        "C55 Only",
        "Accepted Column Maps",
        "Ambiguous Column Maps",
        "Rejected Column Maps",
        "Field Differences"

    ],

    "Value": [

        len(mdi),
        len(c55),
        len(matching_keys),
        len(mdi_only),
        len(c55_only),

        len(
            mapping_df[
                mapping_df["Status"]
                ==
                "Accepted"
            ]
        ),

        len(review_df),
        len(rejected_df),
        len(differences_df)

    ]
})

# ============================================================
# WRITE WORKBOOK
# ============================================================

with pd.ExcelWriter(
    OUTPUT_FILE,
    engine="openpyxl"
) as writer:

    summary_df.to_excel(
        writer,
        sheet_name="Summary",
        index=False
    )

    mapping_df.to_excel(
        writer,
        sheet_name="Column Mapping Matrix",
        index=False
    )

    review_df.to_excel(
        writer,
        sheet_name="Review Required",
        index=False
    )

    rejected_df.to_excel(
        writer,
        sheet_name="Rejected Matches",
        index=False
    )

    differences_df.to_excel(
        writer,
        sheet_name="Field Differences",
        index=False
    )

    pd.DataFrame({
        "Shared Cost Number": mdi_only
    }).to_excel(
        writer,
        sheet_name="MDI Only",
        index=False
    )

    pd.DataFrame({
        "Shared Cost Number": c55_only
    }).to_excel(
        writer,
        sheet_name="C55 Only",
        index=False
    )

    mdi_duplicates.to_excel(
        writer,
        sheet_name="MDI Duplicates",
        index=False
    )

    c55_duplicates.to_excel(
        writer,
        sheet_name="C55 Duplicates",
        index=False
    )

# ============================================================
# APPLY FORMATTING
# ============================================================

wb = load_workbook(
    OUTPUT_FILE
)

for ws in wb.worksheets:

    format_sheet(ws)

# ------------------------------------------------------------
# Column Mapping Matrix colors
# ------------------------------------------------------------

if "Column Mapping Matrix" in wb.sheetnames:

    ws = wb["Column Mapping Matrix"]

    status_col = None

    for c in wsif c.value == "Status":

            status_col = c.column
            break

    if status_col:

        letter = get_column_letter(
            status_col
        )

        rng = (
            f"{letter}2:"
            f"{letter}{ws.max_row}"
        )

        ws.conditional_formatting.add(
            rng,
            CellIsRule(
                operator="equal",
                formula=['"Accepted"'],
                fill=GREEN_FILL
            )
        )

        ws.conditional_formatting.add(
            rng,
            CellIsRule(
                operator="equal",
                formula=['"Ambiguous"'],
                fill=YELLOW_FILL
            )
        )

        ws.conditional_formatting.add(
            rng,
            CellIsRule(
                operator="equal",
                formula=['"Rejected"'],
                fill=GRAY_FILL
            )
        )

# ------------------------------------------------------------
# Summary sheet KPI colors
# ------------------------------------------------------------

if "Summary" in wb.sheetnames:

    ws = wb["Summary"]

    for row in range(
        2,
        ws.max_row + 1
    ):

        metric = ws.cell(
            row,
            1
        ).value

        value_cell = ws.cell(
            row,
            2
        )

        if metric == "Field Differences":

            value_cell.fill = (
                GREEN_FILL
                if value_cell.value == 0
                else RED_FILL
            )

        elif metric in (
            "Ambiguous Column Maps",
            "Rejected Column Maps"
        ):

            if value_cell.value > 0:

                value_cell.fill = (
                    YELLOW_FILL
                )

# ------------------------------------------------------------
# Summary navigation links
# ------------------------------------------------------------

if "Summary" in wb.sheetnames:

    ws = wb["Summary"]

    start_row = ws.max_row + 3

    ws.cell(
        start_row,
        1
    ).value = "Navigation"

    nav_sheets = [

        "Column Mapping Matrix",
        "Review Required",
        "Field Differences",
        "MDI Only",
        "C55 Only"

    ]

    for idx, sheet in enumerate(
        nav_sheets,
        start=1
    ):

        cell = ws.cell(
            start_row + idx,
            1
        )

        cell.value = sheet

        cell.hyperlink = (
            f"#{sheet}!A1"
        )

        cell.style = "Hyperlink"

with pd.ExcelWriter(
    str(OUTPUT_FILE),
    engine="openpyxl"
) as writer:
wb.save(str(OUTPUT_FILE))

print(
    f"Created: {OUTPUT_FILE}"
)
